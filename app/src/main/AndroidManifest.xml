<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networked features: analytics (PostHog) and, if the person opts in via
         the consent screen, the Pawns bandwidth-sharing feature. Drift was
         offline-first before these — see README for what each is used for. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Required by the Pawns SDK's foreground peer service on API 34+. Only
         ever runs after explicit opt-in through ConsentScreen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Still required at runtime on API 33+ for the playback notification to show —
         this is OS behavior, not a store requirement, so it stays even for sideloading. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DriftApp"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drift"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Leanback launcher entry: this is what puts the app on the TV home row -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Pawns bandwidth-sharing peer service — only ever started from
             PawnsManager.grantConsent(), after the person explicitly accepts
             ConsentScreen. Foreground (not background) so there's always a
             persistent, visible notification while it's running: someone
             should never have to wonder whether sharing is still active. -->
        <service
            android:name="com.pawns.sdk.internal.service.PeerServiceForeground"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Allows to share internet traffic by modifying device's network settings to be used as a gateway for internet traffic. Device becomes a gateway which allows to send and receive internet traffic." />
        </service>
        <meta-data
            android:name="com.pawns.sdk.pawns_service_channel_name"
            android:value="Internet Sharing" />
    </application>
</manifest>
