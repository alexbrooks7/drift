<?xml version="1.0" encoding="utf-8"?>
<!--
  Sideload-only additions for the Bright SDK bandwidth-sharing ("Web
  Indexing") integration.

  Unlike Pawns, there is nothing to declare here ourselves: the SDK's own AAR
  (app/libs/bright_sdk.aar) carries its own merged manifest with everything it
  needs already — RECEIVE_BOOT_COMPLETED, FOREGROUND_SERVICE and
  FOREGROUND_SERVICE_DATA_SYNC, its own foreground service (running in a
  separate :cskd_srvh process), its own JobScheduler-bound watchdog service,
  and its own boot/update receiver (BOOT_COMPLETED, MY_PACKAGE_REPLACED,
  PACKAGE_REPLACED). All of that merges in automatically because the
  dependency is sideloadImplementation-only (see app/build.gradle.kts) — the
  store flavor never sees any of it because the AAR was never on its
  classpath, not because anything here excludes it.

  This file exists as a placeholder and a place to explain why it's nearly
  empty, kept in the sideload source set so a store-flavor build can never
  accidentally pick it up.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" />
